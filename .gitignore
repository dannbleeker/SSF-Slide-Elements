node_modules/
dist/
dist-lib/
coverage/
*.local
.DS_Store

# A review agent works in this tree and leaves scratch harnesses behind. They
# are named so they cannot be committed by a `git add -A` on a distracted day —
# which is how one reached CI and turned the branch red.
test/zz*

# The catalogue's markup and parts are GENERATED by `npm run harvest` from the
# decks under template/ and built on deploy; only the index, catalogue.json,
# is committed, and CI fails when it no longer matches the decks.
public/catalogue/16x9/
public/catalogue/4x3/

# Diagnostics from `npm run previews`, alongside the previews themselves.
public/catalogue/previews-report.json

# Where `npm run harvest` builds the catalogue before it replaces the committed
# one. A run that exits early leaves it behind on purpose — the point is that it
# leaves `public/catalogue/` alone — and the next run clears it.
public/.catalogue-staging/

# Where the committed catalogue is parked for the moment the swap takes. It
# exists only between two renames; a run killed in that gap leaves it, and the
# next `stage` puts it back where it came from.
public/.catalogue-previous/
