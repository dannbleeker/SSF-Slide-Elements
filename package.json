{
  "name": "ssf-slide-elements",
  "version": "0.1.0",
  "private": true,
  "description": "A library of slide elements for PowerPoint: browse a curated template deck in the task pane and drop any element onto the slide you are on, with its formatting intact.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "build:lib": "tsc -p tsconfig.lib.json",
    "harvest": "node scripts/harvest.mjs",
    "build:template": "node scripts/build-template.mjs",
    "dev": "vite",
    "build": "vite build",
    "icons": "node scripts/build-icons.mjs",
    "pane-shots": "node scripts/pane-shots.mjs",
    "verify-splice": "node scripts/verify-splice.mjs",
    "manifests": "node scripts/build-manifests.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/office-js": "^1.0.607",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
