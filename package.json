{
  "name": "ssf-slide-elements",
  "version": "0.1.0",
  "private": true,
  "description": "A library of ready-made slide elements for PowerPoint: browse the collection in the task pane and drop any element onto the slide you are on, with its formatting intact.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:count": "node scripts/test-count.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "build:lib": "tsc -p tsconfig.lib.json",
    "harvest": "node scripts/harvest.mjs",
    "probe": "node scripts/build-probe.mjs",
    "dev": "vite",
    "build": "vite build",
    "icons": "node scripts/build-icons.mjs",
    "manifests": "node scripts/build-manifests.mjs",
    "release:check": "node scripts/check-release.mjs",
    "pane-shots": "node scripts/pane-shots.mjs",
    "sibling-watch": "node scripts/sibling-watch.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/office-js": "^1.0.607",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
